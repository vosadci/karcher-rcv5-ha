{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:developers.home-assistant.io)",
      "WebFetch(domain:www.home-assistant.io)",
      "WebFetch(domain:hacs.xyz)",
      "WebFetch(domain:riddix.github.io)",
      "Bash(gh api:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(make install)",
      "Bash(make test)",
      "Bash(make test-cov)",
      "Bash(make lint)",
      "Bash(make type)",
      "Bash(make check)",
      "Bash(make precommit)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 -m ruff*)",
      "Bash(python3 -m mypy*)",
      "Bash(python3 -c *)",
      "Bash(pre-commit run*)",
      "Bash(git commit*)",
      "Bash(git add*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout --*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Claude stopped] Do not commit or push without explicit instruction. If the integration package changed, remind the user to run make check or test locally.'",
            "async": true
          }
        ]
      }
    ]
  }
}
